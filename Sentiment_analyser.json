qna_accuracy, qna_exact_match, qna_f1 = evaluate_qna(model_qna, tokenizer_qna, qna_dataset, device)

print(f"Question Answering Accuracy: {qna_accuracy*100:.2f}%")
print(f"Question Answering Exact Match: {qna_exact_match*100:.2f}%")
print(f"Question Answering F1 Score: {qna_f1:.2f}")


def run_all_benchmarks():
    all_results = {}

    # Evaluate Sentiment Analysis
    print("\n=== Running Sentiment Analysis Benchmark ===")

