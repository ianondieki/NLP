# Define the model for question answering (SQuAD)
MODEL_NAME_QNA = "distilbert-base-uncased-distilled-squad"

### YOUR CODE HERE ###
tokenizer_qna = AutoTokenizer.from_pretrained(MODEL_NAME_QNA)
model_qna = AutoModelForQuestionAnswering.from_pretrained(MODEL_NAME_QNA)
model_qna = model_qna.to(device)


def evaluate_qna(model, tokenizer, dataset, device):
    model.eval()
    correct = 0
    total = 0
    exact_matches = []
    f1_scores = []

    for item in dataset:
        question = item['question']
        context = item['context']
        answers = item['answers']  # usually {"text": ["Paris"], "answer_start": [23]}

        # Tokenize question + context
        tokenized = tokenizer(
            question,
            context,
            padding="max_length",
            truncation=True,
            max_length=512,
            return_tensors="pt"
        )
        inputs = {key: value.to(device) for key, value in tokenized.items()}

        # Forward pass
        outputs = model(**inputs)

        # Predicted start and end indices
        start_idx = outputs.start_logits.argmax(-1).item()
        end_idx   = outputs.end_logits.argmax(-1).item()

        # Decode predicted answer
        predicted_answer = tokenizer.decode(
            inputs["input_ids"][0][start_idx:end_idx+1],
            skip_special_tokens=True
        )

        # True answer
        true_answer = answers["text"][0]

        # Exact match
        exact_match = int(predicted_answer.strip().lower() == true_answer.strip().lower())
        exact_matches.append(exact_match)

        # F1 score (token overlap)
        pred_tokens = predicted_answer.split()
        true_tokens = true_answer.split()
        common = set(pred_tokens) & set(true_tokens)
        if len(common) == 0:
            f1 = 0.0
        else:
            precision = len(common) / len(pred_tokens)
            recall = len(common) / len(true_tokens)
            f1 = 2 * precision * recall / (precision + recall)
        f1_scores.append(f1)

        if exact_match == 1:
            correct += 1
        total += 1

    # Aggregate metrics
    accuracy = correct / total
    avg_f1 = sum(f1_scores) / total
    avg_exact_match = sum(exact_matches) / total

    return accuracy, avg_exact_match, avg_f1


# Load the SQuAD dataset (question answering dataset)
qna_dataset = load_dataset("squad", split="validation")

